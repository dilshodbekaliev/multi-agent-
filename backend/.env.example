# Copy this file to .env and fill in your OWN keys.
# NEVER commit the real .env file.

# --- Required ---
GOOGLE_API_KEY=your_gemini_key_here          # https://aistudio.google.com/apikey

# --- Optional (project still works without these) ---
TAVILY_API_KEY=your_tavily_key_here          # https://tavily.com  (F4 web agent)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key # https://cloud.langfuse.com (F12 tracing)
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Qdrant ---
# Leave blank to use embedded (local, no signup) Qdrant.
# Fill in to use Qdrant Cloud instead.
QDRANT_URL=
QDRANT_API_KEY=

# --- Database (F5 Text-to-SQL) ---
DATABASE_PATH=./data/company.db
